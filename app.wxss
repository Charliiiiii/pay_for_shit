page {
  background: #e3f4ff;
  min-height: 100vh;
  color: #1565c0;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.gold-text {
  color: #0d47a1;
  font-weight: 700;
}

.btn-primary {
  background: #1e88e5;
  color: #ffffff;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #1976d2;
  border-radius: 999rpx;
  border: 2rpx solid #90caf9;
}

button::after {
  border: none;
}
