page {
  background: #f7f5f6;
  min-height: 100vh;
  color: #8b8186;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

.gold-text {
  color: #756a70;
  font-weight: 700;
}

.btn-primary {
  background: #a79aa2;
  color: #ffffff;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #8b8186;
  border-radius: 999rpx;
  border: 2rpx solid #d8d0d4;
}

button::after {
  border: none;
}
