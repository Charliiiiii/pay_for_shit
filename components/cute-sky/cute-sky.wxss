.cute-sky {
  position: relative;
  margin: -8rpx 0 24rpx;
  overflow: visible;
}

.cute-sky--compact {
  margin-bottom: 16rpx;
}

.sky-banner-wrap {
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  line-height: 0;
  border: 2rpx solid #bbdefb;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(30, 136, 229, 0.1);
}

.cute-sky--compact .sky-banner-wrap {
  height: 120rpx;
  border-radius: 16rpx;
}

.sky-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}
