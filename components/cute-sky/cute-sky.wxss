.cute-sky {
  position: relative;
  margin: -8rpx 0 24rpx;
  overflow: visible;
}

.cute-sky--compact {
  margin-bottom: 16rpx;
}

.sky-banner-wrap {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  line-height: 0;
  background: #ffffff;
  border: 2rpx solid #e6e1e4;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(236, 64, 122, 0.12);
}

.cute-sky--compact .sky-banner-wrap {
  height: 168rpx;
  border-radius: 16rpx;
}

.sky-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}
