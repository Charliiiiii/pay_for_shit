<view class="page">
  <cute-sky compact="{{true}}" />
  <view class="card">
    <text class="label">用户名与头像（排行榜展示）</text>

    <view class="profile-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback">
          <text class="avatar-plus">+</text>
          <text class="avatar-tip">头像</text>
        </view>
      </button>
      <input
        class="input profile-name-input"
        placeholder="输入昵称（例如：厕所哲学家）"
        value="{{nicknameInput}}"
        bindinput="onNicknameInput"
      />
    </view>

    <button class="btn-save" bindtap="onSaveProfile">保存资料</button>
  </view>

  <view class="card">
    <text class="label">月薪（元）</text>
    <input class="input" type="digit" placeholder="例如 8000" value="{{salaryInput}}" bindinput="onSalaryInput" />
    <text class="label label--spaced">每日工时（小时）</text>
    <text class="hint">时薪 = 月薪 ÷ 21.75 天 ÷ 每日工时；常见 8，支持小数如 7.5</text>
    <input class="input" type="digit" placeholder="例如 8" value="{{hoursInput}}" bindinput="onHoursInput" />
    <text class="preview" wx:if="{{hourlyPreview > 0}}">当前估算时薪：¥ {{hourlyPreview}} / 小时</text>

    <view class="switch-row">
      <text class="switch-label">排行榜显示金额</text>
      <switch
        checked="{{rankShowAmount}}"
        bindchange="onToggleRankAmount"
        color="#a79aa2"
      />
    </view>
    <text class="hint">关闭后，排行榜仅显示时长，不显示金额。</text>

    <button class="btn-save" bindtap="onSave">保存</button>
  </view>

  <view class="card">
    <button class="btn-danger" bindtap="onClearRecords">清空所有记录</button>
    <text class="label-paren label-paren-right">（仅清空记录，月薪设置保留）</text>
  </view>
</view>
