.page {
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #e6e1e4;
  box-shadow: 0 8rpx 24rpx rgba(236, 64, 122, 0.1);
}

.label {
  font-size: 32rpx;
  font-weight: 700;
  color: #756a70;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.label--spaced {
  margin-top: 28rpx;
}

.label-paren {
  font-size: 24rpx;
  font-weight: 400;
  color: #a8a1a5;
}

.label-paren-right {
  display: block;
  text-align: right;
  margin-top: 16rpx;
  line-height: 1.4;
}

.card--danger {
  margin-bottom: 28rpx;
}

.hint {
  font-size: 24rpx;
  color: #a8a1a5;
  display: block;
  margin-bottom: 20rpx;
}

.input {
  background: #f7f5f6;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  color: #756a70;
  font-size: 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e6e1e4;
}

.preview {
  font-size: 26rpx;
  color: #8b8186;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 10rpx;
}

.switch-label {
  font-size: 28rpx;
  color: #756a70;
  font-weight: 600;
}

.btn-save {
  background: #a79aa2;
  color: #ffffff;
  font-weight: 800;
  border-radius: 999rpx;
  border: none;
  margin-top: 8rpx;
}

.btn-danger {
  background: #fff0f4;
  color: #8b8186;
  border: 2rpx solid #d8d0d4;
  border-radius: 999rpx;
  margin-top: 8rpx;
}

.btn-share {
  background: #ffffff;
  color: #8b8186;
  border: 2rpx solid #d8d0d4;
  border-radius: 999rpx;
  margin-top: 8rpx;
}
