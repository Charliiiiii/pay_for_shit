.page {
  position: relative;
  z-index: 0;
  padding: 24rpx 36rpx calc(140rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  margin-bottom: 20rpx;
}

.action-area {
  margin-bottom: 8rpx;
}

.btn-hover {
  opacity: 0.92;
  transform: scale(0.98);
}

.btn-hover-light {
  opacity: 0.88;
}

.emoji-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.emoji-main {
  font-size: 72rpx;
  line-height: 1;
}

.emoji-side {
  font-size: 44rpx;
  line-height: 1;
}

.title {
  font-size: 46rpx;
  font-weight: 800;
  color: #756a70;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b5adb2;
}

.timer-card {
  position: relative;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 28rpx 36rpx;
  border: 3rpx solid #e6e1e4;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(236, 64, 122, 0.14);
}

.timer-card.pulse {
  animation: breathe 1.8s ease-in-out infinite;
}

@keyframes breathe {
  0%,
  100% {
    box-shadow: 0 12rpx 32rpx rgba(236, 64, 122, 0.14);
  }
  50% {
    box-shadow: 0 16rpx 40rpx rgba(236, 64, 122, 0.2);
  }
}

/* 计时行：图标 + 数字对齐 */
.clock-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 4rpx 0;
}

.clock-icon-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.clock-icon {
  font-size: 52rpx;
  line-height: 1;
}

.clock-digits {
  flex-shrink: 0;
  font-size: 68rpx;
  font-weight: 800;
  /* 小程序端并非都支持 tabular-nums，额外指定等宽数字字体防止抖动 */
  font-family: "SF Mono", Menlo, Consolas, "Roboto Mono", monospace;
  font-variant-numeric: tabular-nums;
  color: #8b8186;
  letter-spacing: 6rpx;
  line-height: 72rpx;
  min-width: 260rpx;
  text-align: center;
}

.running-label {
  display: block;
  margin: 0 auto 10rpx;
  padding: 0 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #756a70;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.big-btn {
  width: 100%;
  padding: 36rpx 24rpx;
  font-size: 36rpx;
  font-weight: 800;
  border-radius: 999rpx;
  border: none;
  line-height: 1.2;
}

.big-btn.start {
  position: relative;
  background: #a79aa2;
  color: #ffffff;
  border: none;
}

.big-btn.running {
  background: #f7f5f6;
  color: #756a70;
  border: 3rpx solid #d8d0d4;
}

.preview-earn {
  display: block;
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.warn-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b5adb2;
}

.end-row {
  position: relative;
  margin-top: 28rpx;
  text-align: center;
}

.btn-end {
  background: #ffffff;
  color: #8b8186;
  font-size: 28rpx;
  border: 2rpx solid #d8d0d4;
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
}

.stats-block {
  margin-top: 32rpx;
  padding: 28rpx 32rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid #e6e1e4;
  box-shadow: 0 8rpx 24rpx rgba(236, 64, 122, 0.08);
}

.stats-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #b5adb2;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.stat-line {
  font-size: 30rpx;
  margin-bottom: 14rpx;
  color: #8b8186;
}

.divider {
  height: 2rpx;
  background: #f7f5f6;
  margin: 24rpx 0;
}

.last-record,
.best {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.muted {
  font-size: 26rpx;
  color: #a8a1a5;
}

.metric-label {
  width: 140rpx;
  text-align: right;
}

.metric-value {
  flex: 1;
}

.footer-actions {
  margin-top: 36rpx;
  display: flex;
  justify-content: stretch;
  gap: 24rpx;
  padding: 0 4rpx;
}

.link-btn {
  flex: 1;
  background: #ffffff;
  color: #8b8186;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #d8d0d4;
  max-width: none;
}

/* 💩 雨：最顶层显示；pointer-events:none 让点击穿透到下方按钮 */
.poop-rain {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  pointer-events: none;
  overflow: hidden;
}

.poop-drop {
  position: absolute;
  top: -100rpx;
  animation-name: poop-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  line-height: 1;
  will-change: transform;
}

.poop-emoji {
  display: block;
  line-height: 1;
}

@keyframes poop-fall {
  0% {
    transform: translate3d(-50%, 0, 0) rotate(0deg);
  }
  100% {
    transform: translate3d(-50%, 165vh, 0) rotate(360deg);
  }
}
