<view class="page">
  <view class="card">
    <text class="label">用户设置</text>
    <view class="profile-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" binderror="onAvatarLoadError" />
        <view wx:else class="avatar-fallback">
          <text class="avatar-plus">+</text>
          <text class="avatar-tip">头像</text>
        </view>
      </button>
      <input
        class="input profile-name-input"
        placeholder="输入昵称（例如：厕所哲学家）"
        value="{{nicknameInput}}"
        bindinput="onNicknameInput"
      />
    </view>
    <text class="label">月薪（元）</text>
    <input class="input" type="digit" placeholder="例如 8000" value="{{salaryInput}}" bindinput="onSalaryInput" />
    <text class="label label--spaced">每日工时（小时）</text>
    <text class="hint">时薪 = 月薪 ÷ 21.75 天 ÷ 每日工时；常见 8，支持小数如 7.5</text>
    <input class="input" type="digit" placeholder="例如 8" value="{{hoursInput}}" bindinput="onHoursInput" />
    <text class="preview" wx:if="{{hourlyPreview > 0}}">当前估算时薪：¥ {{hourlyPreview}} / 小时</text>

    <view class="switch-row">
      <text class="switch-label">排行榜显示金额</text>
      <switch checked="{{rankShowAmount}}" bindchange="onToggleRankAmount" color="#d4aea1" />
    </view>
    <text class="hint">关闭后，排行榜仅显示时长，不显示金额。</text>
    <button class="btn-primary" bindtap="onSaveAll">保存资料与设置</button>
  </view>

  <view class="card">
    <text class="label">记录数据</text>
    <view class="record-line">总次数：<text class="record-value">{{recordCount}}</text></view>
    <view class="record-line">今日累计：<text class="record-value">¥ {{summary.todayTotal}}</text></view>
    <view class="record-line">本周累计：<text class="record-value">¥ {{summary.weekTotal}}</text></view>
    <view class="record-line">本月累计：<text class="record-value">¥ {{summary.monthTotal}}</text></view>
    <view class="record-line">总收益：<text class="record-value">¥ {{summary.allTimeTotal}}</text></view>

    <view wx:if="{{recentRecords.length}}" class="recent-wrap">
      <text class="recent-title">最近记录</text>
      <view wx:for="{{recentRecords}}" wx:key="id" class="recent-item">
        <text class="recent-time">{{item.timeText}}</text>
        <text class="recent-meta">{{item.durationText}}</text>
        <text class="recent-earn">¥ {{item.earned}}</text>
      </view>
    </view>

    <view class="record-actions">
      <button class="btn-ghost" bindtap="goHistory">查看全部记录</button>
      <button class="btn-danger" bindtap="onClearRecords">清空记录</button>
    </view>
  </view>
</view>
