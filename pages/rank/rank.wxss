.page {
  min-height: 100vh;
  padding: 24rpx 20rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.seg-item--on {
  background: #f7f5f6;
  color: #756a70;
  border: 2rpx solid #d8d0d4;
}

.seg-item--off {
  background: #ffffff;
  color: #a8a1a5;
  border: 2rpx solid #e6e1e4;
}

.list {
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #e6e1e4;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 2rpx solid #f7f5f6;
}

.row:last-child {
  border-bottom: none;
}

.row--me {
  background: #fff6fa;
}

.rank {
  width: 56rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #8b8186;
  text-align: center;
}

.avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 14rpx 0 6rpx;
  background: #f7f5f6;
  border: 2rpx solid #e6e1e4;
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b8186;
  font-size: 26rpx;
  font-weight: 700;
}

.mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 800;
  color: #756a70;
}

.right {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.amt {
  font-size: 22rpx;
  font-weight: 700;
  color: #a8a1a5;
}

.time {
  font-size: 30rpx;
  font-weight: 900;
  color: #8b8186;
}

.sub {
  font-size: 22rpx;
  color: #a8a1a5;
}

.foot {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #a8a1a5;
  line-height: 1.5;
}
