<view class="page">
  <view class="list">
    <view
      wx:for="{{rows}}"
      wx:key="id"
      class="row {{item.isMe ? 'row--me' : ''}}"
    >
      <text class="rank">{{item.rank}}</text>
      <view class="avatar-wrap">
        <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" data-idx="{{index}}" binderror="onAvatarError" />
        <view wx:else class="avatar-text">{{item.name.slice(0, 1)}}</view>
      </view>
      <view class="mid">
        <text class="name">{{item.name}}</text>
        <text class="sub">本周 {{item.sessions}} 次噗噗</text>
      </view>
      <view class="right">
        <text class="time">{{item.durationText}}</text>
        <text wx:if="{{showAmountInRank}}" class="amt">¥{{item.weeklyDisplay}}</text>
      </view>
    </view>
  </view>

  <view class="foot">{{isCloud ? "用户可在“我的”里决定是否在排行榜显示金额" : "当前为本地演示榜；云榜加载失败时自动回退"}}</view>
</view>
