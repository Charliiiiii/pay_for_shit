.page {
  padding: 16rpx 24rpx 80rpx;
}

.empty {
  text-align: center;
  color: #a8a1a5;
  padding: 120rpx 32rpx;
  font-size: 28rpx;
}

.day-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e6e1e4;
  box-shadow: 0 6rpx 20rpx rgba(236, 64, 122, 0.1);
}

.day-head {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 16rpx;
}

.day-date {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #756a70;
}

.day-meta {
  font-size: 26rpx;
  color: #b5adb2;
}

.chev {
  font-size: 24rpx;
  color: #b5adb2;
  margin-left: 8rpx;
}

.day-body {
  border-top: 2rpx solid #f7f5f6;
  padding: 8rpx 0 16rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #8b8186;
}

.t {
  width: 140rpx;
  color: #b8b3b6;
}

.d {
  flex: 1;
}

.e {
  font-weight: 700;
}

.gold {
  color: #756a70;
}
