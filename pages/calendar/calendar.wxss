.page {
  min-height: 100vh;
  padding: 24rpx 20rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #8b8186;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e6e1e4;
}

.month-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #756a70;
}

.week-head {
  display: flex;
  margin-bottom: 12rpx;
}

.wh {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #a8a1a5;
  font-weight: 600;
}

.grid {
  background: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid #e6e1e4;
  padding: 12rpx 8rpx 20rpx;
}

.week-row {
  display: flex;
}

.cell {
  flex: 1;
  min-height: 112rpx;
  border-radius: 12rpx;
  margin: 4rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fbf9fa;
}

.cell--pad {
  background: transparent;
  border: none;
}

.cell--has {
  background: #f7f5f6;
  border: 2rpx solid #d8d0d4;
}

.day-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #8b8186;
}

.poop-wrap {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2rpx 4rpx;
  max-width: 100%;
}

.poop {
  font-size: 22rpx;
  line-height: 1;
}

.overflow {
  font-size: 20rpx;
  color: #8b8186;
  font-weight: 700;
  align-self: center;
}

.hint {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #a8a1a5;
  line-height: 1.5;
  padding: 0 8rpx;
}
